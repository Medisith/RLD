APP_NAME="Rate Limiter Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Sem banco relacional nesta fase: sqlite em memória atende o boot do framework.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Redis — única dependência de infraestrutura real do limitador.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Chaves de negócio do limitador (ver config/limitacao_requisicoes.php)
LIMITACAO_HABILITADO=true
LIMITACAO_ALGORITMO=ingenuo
LIMITACAO_ESTRATEGIA_CHAVE=usuario_ou_ip
LIMITACAO_CAPACIDADE=50
LIMITACAO_JANELA_SEGUNDOS=60
LIMITACAO_CUSTO_PADRAO=1
LIMITACAO_MODO_FALHA=fechado
