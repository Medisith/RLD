APP_NAME="Rate Limiter Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Sem banco relacional nesta fase: sqlite em memória atende o boot do framework.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Redis — única dependência de infraestrutura real do limitador.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Chaves de negócio do limitador (ver config/rate_limiting.php)
RATE_LIMIT_ENABLED=true
# naive (Fase 1, didático/inseguro) | token_bucket (Fase 2) | leaky_bucket (Fase 3)
RATE_LIMIT_ALGORITHM=token_bucket
RATE_LIMIT_KEY_STRATEGY=user_or_ip
RATE_LIMIT_CAPACITY=50
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REFILL_RATE=1.0
RATE_LIMIT_LEAK_RATE=1.0
RATE_LIMIT_DEFAULT_COST=1
# open (passa sem contagem se o Redis cair) | closed (503 se o Redis cair)
RATE_LIMIT_FAILURE_MODE=closed

# Proxies confiáveis para X-Forwarded-For (Fase 6). Vazio = nenhum proxy
# confiável (headers ignorados; IP = peer TCP). Atrás de LB: lista de IPs/
# CIDRs separados por vírgula, ou "*" SOMENTE se o app é inalcançável fora
# do LB. Com config:cache, defina como variável de ambiente real.
TRUSTED_PROXIES=

# Algoritmo da rota de teste (Fase 8 — troca rápida para comparação k6/demo).
RATE_LIMIT_PING_ALGORITHM=token_bucket

# Quota composta por tenant (Fase 9) — desligada por padrão. Ligada, cada
# requisição com o header X-Tenant-Id também consome o balde do tenant.
RATE_LIMIT_TENANT_ENABLED=false
RATE_LIMIT_TENANT_CAPACITY=200
RATE_LIMIT_TENANT_ALGORITHM=token_bucket
RATE_LIMIT_TENANT_REFILL_RATE=4.0
